# -------- API NewsRadar --------
# Dentro de la red de docker-compose, la API es accesible por el nombre del servicio.
API_BASE_URL=http://api:8000

# Usuario con el que el demonio se autentica.
# El seed crea este admin automáticamente.
DAEMON_EMAIL=admin@newsradar.com
DAEMON_PASSWORD=admin123

# -------- SMTP (Gmail) --------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_SENDER=@gmail.com
GMAIL_APP_PASSWORD=

# -------- Demonio --------
RSS_SOURCES_PATH=/data/rss_sources.json
ALERT_REFRESH_INTERVAL=5
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Europe/Madrid
